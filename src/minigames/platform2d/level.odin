LEVEL_ROWS :: 22
// Top row of the ground every chunk joins on; the player stands one row above.
FLOOR_ROW :: 18
// Rows above the floor that must stay open at chunk joins.
JOIN_HEADROOM :: 5

chunk_char :: proc(def: Chunk_Def, x, y: int) -> u8 {
	pad := LEVEL_ROWS - len(def.rows)
	if y < pad {
		return '.'
	}
	row := def.rows[y-pad]
	if x < 0 || x >= len(row) {
		return '#'
	}
	return row[x]
}

chunk_width :: proc(def: Chunk_Def) -> int {
	return len(def.rows[0]) if len(def.rows) > 0 else 0
}

// Structural checks shared by tests and generation: equal row widths, known
// characters, and the join columns a middle chunk promises its neighbours.
chunk_valid :: proc(def: Chunk_Def) -> bool {
	if len(def.rows) == 0 || len(def.rows) > LEVEL_ROWS {
		return false
	}
	width := chunk_width(def)
	if width < 8 {
		return false
	}
	spawns, exits := 0, 0
	for row in def.rows {
		if len(row) != width {
			return false
		}
		for ch in transmute([]u8)row {
			switch ch {
			case '.', '#', '=', '%', '^', '~', 'o', 'g', 'b', 't':
			case 'S':
				spawns += 1
			case 'E':
				exits += 1
			case:
				return false
			}
		}
	}
	switch def.role {
	case .Start:
		return spawns == 1 && exits == 0 && join_open(def, width-2)
	case .End:
		return spawns == 0 && exits == 1 && join_open(def, 0)
	case .Middle:
		return spawns == 0 && exits == 0 && join_open(def, 0) && join_open(def, width-2)
	}
	return false
}

@(private)
join_open :: proc(def: Chunk_Def, first_column: int) -> bool {
	for x in first_column..<first_column+2 {
		for y in FLOOR_ROW..<LEVEL_ROWS {
			if chunk_char(def, x, y) != '#' {
				return false
			}
		}
		for y in FLOOR_ROW-JOIN_HEADROOM..<FLOOR_ROW {
			if chunk_char(def, x, y) != '.' {
				return false
			}
		}
	}
	return true
}

chunk_index :: proc(name: string) -> int {
	for def, i in CHUNKS {
		if def.name == name {
			return i
		}
	}
	return -1
}
