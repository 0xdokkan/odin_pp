package platform2d

// Hand-authored level chunks. Every middle chunk enters and leaves on the same
// floor row with open headroom at its first and last two columns, so any
// sequence of chunks joins into a continuous, completable level. Rows are
// bottom-aligned: shorter chunks are padded with sky on top.
//
//   #  stone          =  one-way ledge     %  crumbling block
//   ^  spikes         ~  lava              o  ember
//   g  ghoul          b  bat               t  skull totem
//   S  spawn          E  exit portal (bottom-left cell, portal is 2x3)

Chunk_Role :: enum u8 {
	Middle,
	Start,
	End,
}

Chunk_Def :: struct {
	name:  string,
	// Area name shown in the HUD.
	title: string,
	role:  Chunk_Role,
	// 0 introduces a mechanic, 1 combines two, 2 demands double jump and dash.
	tier:  int,
	// Expected seconds for a competent player, used for par and time limits.
	par:   f32,
	rows:  []string,
}

