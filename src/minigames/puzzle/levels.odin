package puzzle

// The level library, from tutorials to the hardest crypts. Glyphs are listed
// on parse_level. Each par is the optimal move count found by the solver; the
// tests re-solve every level and fail if a par drifts.

Level_Def :: struct {
	name: string,
	rank: int, // 1 tutorial .. 5 hardest
	par:  int,
	rows: []string,
}

