package gfx

// Living cards (PROVA MECCANICHE): the board characters drawn smaller on a
// still card and hand-animated on it. Each clip is a run of drawings in its
// atlas (row-major, LIVING_COLUMNS per row); the card has one field.
Living_Action :: enum u8 {Idle, Move_Side, Move_Up, Move_Down, Attack, Windup, Cast, Channel, Hurt, Hurt_Back, Block, Dodge, Stunned, Interact, Death}
// How a move clip slides the card across the board (living_card.odin).
Living_Travel :: enum u8 {None, Shove, Run, Stomp, Hop, Glide, Dash, Float}
LIVING_MAX_FRAMES :: 48
LIVING_COLUMNS :: 16
// The drawings' size against the classic print: the card shader's edge
// offset is scaled by it so lines keep their classic thickness.
LIVING_PRINT_SCALE :: f32(0.890)

// Durations are milliseconds per drawing; `hit` is the drawing on the
// action's impact (-1: none); a move clip starts sliding the card at
// `travel_start` ms, for `travel_ms`.
Living_Clip :: struct {first, count, hit: i32, loop: bool, travel: Living_Travel, travel_start, travel_ms: u16, durations: [LIVING_MAX_FRAMES]u16}

// `cell` is one drawing in pixels, `feet` the resting ground contact in it,
// `ground` the paper under the feet beyond the shader's own; the field adds
// `card_margin` pixels on every side of the cell.
Living_Sheet :: struct {
	cell: [2]i32,
	feet: [2]f32,
	rest_height, world_height, ground: f32,
	card_margin: i32,
	paper_cell: [2]i32,
	clips: [Living_Action]Living_Clip,
}

