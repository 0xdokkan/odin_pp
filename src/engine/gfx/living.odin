package gfx

import "core:c"
import "core:fmt"
import "core:strings"
import rl "vendor:raylib"

// Living cards (living_data.odin, generated by tools/art/build_living.py):
// the board characters drawn a little smaller on a still card and animated on
// it like drawings on paper. The card never changes; it has one distance
// field per character. Loaded the first time the board shows them.

// The drawing paper of a living card: whiter than the classic card, so the
// light cloaks and robes stand out on it.
LIVING_SHEET_COLOR :: [3]f32{0.945, 0.937, 0.902}

// The action ring: a line `width` screen pixels wide along the card's cut (the
// outer edge of its ink). Drawn with the card's field on a quad larger than
// the card, it is a larger copy of the card's outline.
LIVING_RING_FRAGMENT :: `#version 330
in vec2 fragTexCoord;
in vec4 fragColor;
uniform sampler2D texture0;
uniform float width;
out vec4 finalColor;
void main() {
    float d = texture(texture0, fragTexCoord).r*255.0/PAPER_SCALE;
    float px = max(fwidth(d), 0.0001);
    float line = 1.0 - smoothstep(width*0.5 - 0.6, width*0.5 + 0.6, abs(d - CUT_PX)/px);
    if (line < 0.01) discard;
    finalColor = vec4(fragColor.rgb, fragColor.a*line);
}`

Living_Assets :: struct {
	frames, papers: [Flipbook_Character]rl.Texture2D,
	// CPU copies of the fields, for picking on the paper itself.
	fields: [Flipbook_Character][]u8,
	ring_shader: rl.Shader,
	ring_width_location: c.int,
	loaded, failed: bool,
}

living_ring_source :: proc() -> cstring {
	source := string(LIVING_RING_FRAGMENT)
	tokens := [2]string{"PAPER_SCALE", "CUT_PX"}
	values := [2]f32{FLIPBOOK_PAPER_SCALE, FLIPBOOK_PAPER+FLIPBOOK_INK}
	for token, index in tokens {
		source, _ = strings.replace_all(source, token, fmt.tprintf("%.4f", values[index]), context.temp_allocator)
	}
	return strings.clone_to_cstring(source, context.temp_allocator)
}

create_living_assets :: proc(assets: ^Living_Assets) {
	for character in Flipbook_Character {
		for bytes, kind in ([2][]u8{LIVING_FRAMES_PNG[character], LIVING_PAPER_PNG[character]}) {
			img := rl.LoadImageFromMemory(".png", raw_data(bytes), c.int(len(bytes)))
			if img.data == nil { continue }
			if kind == 0 {
				texture := rl.LoadTextureFromImage(img)
				// The drawings are pixel art: never filtered.
				rl.SetTextureFilter(texture, .POINT)
				assets.frames[character] = texture
			} else {
				colors := rl.LoadImageColors(img)
				field := make([]u8, int(img.width)*int(img.height))
				for &value, index in field { value = colors[index].r }
				rl.UnloadImageColors(colors)
				assets.fields[character] = field
				// One channel is enough for a distance field.
				rl.ImageFormat(&img, .UNCOMPRESSED_GRAYSCALE)
				texture := rl.LoadTextureFromImage(img)
				rl.SetTextureFilter(texture, .BILINEAR)
				rl.SetTextureWrap(texture, .CLAMP)
				assets.papers[character] = texture
			}
			rl.UnloadImage(img)
		}
	}
	assets.loaded = true
	for character in Flipbook_Character {
		if assets.frames[character].id == 0 || assets.papers[character].id == 0 { assets.loaded = false }
	}
	assets.failed = !assets.loaded
	// The rings are an extra: the cards do without them.
	assets.ring_shader = rl.LoadShaderFromMemory(nil, living_ring_source())
	if assets.ring_shader.id != 0 { assets.ring_width_location = rl.GetShaderLocation(assets.ring_shader, "width") }
}

destroy_living_assets :: proc(assets: ^Living_Assets) {
	for character in Flipbook_Character {
		if assets.frames[character].id != 0 { rl.UnloadTexture(assets.frames[character]) }
		if assets.papers[character].id != 0 { rl.UnloadTexture(assets.papers[character]) }
		delete(assets.fields[character])
	}
	if assets.ring_shader.id != 0 { rl.UnloadShader(assets.ring_shader) }
	assets^ = {}
}

// A character without a dedicated clip borrows the closest one it has.
living_resolve :: proc(character: Flipbook_Character, action: Living_Action) -> Living_Action {
	clips := &LIVING_SHEETS[character].clips
	current := action
	for _ in 0..<4 {
		if clips[current].count > 0 { return current }
		switch current {
		case .Move_Up, .Move_Down, .Dodge: current = .Move_Side
		case .Hurt_Back, .Block: current = .Hurt
		case .Cast: current = .Attack
		case .Channel, .Idle, .Move_Side, .Attack, .Windup, .Hurt, .Stunned, .Interact, .Death: current = .Idle
		}
	}
	return .Idle
}

living_priority :: proc(action: Living_Action) -> int {
	switch action {
	case .Death: return 6
	case .Hurt, .Hurt_Back: return 5
	case .Cast, .Attack: return 4
	case .Block, .Dodge: return 3
	case .Interact: return 2
	case .Move_Side, .Move_Up, .Move_Down: return 1
	case .Idle, .Windup, .Stunned, .Channel: return 0
	}
	return 0
}

living_clip_seconds :: proc(clip: ^Living_Clip, first: i32 = 0) -> f64 {
	total: f64
	for index in max(first, 0)..<clip.count { total += f64(clip.durations[index]) }
	return total/1000
}

// Seconds from a clip's start to its hit drawing (0 without one): when an
// attack clip's blow lands (render/attack_fx.odin).
living_hit_seconds :: proc(clip: ^Living_Clip) -> f64 {
	total: f64
	for index in 0..<clamp(clip.hit, 0, clip.count) { total += f64(clip.durations[index]) }
	return total/1000
}

// The drawing shown `elapsed` seconds into a clip that began at drawing
// `first`. A finished one-shot holds its last drawing.
living_frame :: proc(clip: ^Living_Clip, elapsed: f64, first: i32 = 0) -> (frame: i32, finished: bool) {
	if clip.count <= 0 { return 0, true }
	t := max(elapsed, 0)*1000
	if clip.loop {
		cycle := living_clip_seconds(clip)*1000
		if cycle <= 0 { return 0, false }
		for t >= cycle { t -= cycle }
		for index in 0..<clip.count {
			duration := f64(clip.durations[index])
			if t < duration { return index, false }
			t -= duration
		}
		return clip.count-1, false
	}
	for index in clamp(first, 0, clip.count-1)..<clip.count {
		duration := f64(clip.durations[index])
		if t < duration { return index, false }
		t -= duration
	}
	return clip.count-1, true
}

// The atlas rectangle of a clip's drawing.
living_source :: proc(sheet: ^Living_Sheet, clip: ^Living_Clip, frame: i32) -> rl.Rectangle {
	index := clip.first+clamp(frame, 0, max(clip.count-1, 0))
	col, row := index%LIVING_COLUMNS, index/LIVING_COLUMNS
	w, h := f32(sheet.cell.x), f32(sheet.cell.y)
	return {f32(col)*w, f32(row)*h, w, h}
}
