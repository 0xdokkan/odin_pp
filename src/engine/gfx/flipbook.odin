package gfx

import "core:c"
import "core:fmt"
import "core:math"
import "core:strings"
import rl "vendor:raylib"
import rlgl "vendor:raylib/rlgl"

// Paper standees shared by the board and every minigame: a pixel-art print
// that plays flipbook drawings (flipbook_data.odin, generated by
// tools/art/build_sprites.py) on a paper card cut a little wider than the
// drawing. Each drawing carries a distance field to its silhouette; when the
// print turns a page, the paper's cut morphs from the old drawing to the new
// one, reaching out where an arm extends and drawing back as it returns.

// How long the paper takes to follow the print to a new drawing.
FLIPBOOK_MORPH_SECONDS :: f64(0.09)
// The card's paper colour (living cards draw on a whiter sheet, living.odin).
FLIPBOOK_SHEET_COLOR :: [3]f32{0.894, 0.867, 0.788}

// Samples two drawings' fields and blends them, then cuts paper, the
// visible card edge (offset down-right) and the ink line from the result.
FLIPBOOK_PAPER_FRAGMENT :: `#version 330
in vec2 fragTexCoord;
in vec4 fragColor;
uniform sampler2D texture0;
uniform vec4 frameA;
uniform vec4 frameB;
uniform float morph;
uniform vec2 cell;
uniform vec2 edgeDir;
uniform vec3 sheetColor;
out vec4 finalColor;
float field(vec4 r, vec2 uv) {
    vec2 p = r.xy + clamp(uv, vec2(0.002), vec2(0.998))*r.zw;
    return texture(texture0, p).r*255.0/PAPER_SCALE;
}
float dist(vec2 uv) { return mix(field(frameA, uv), field(frameB, uv), morph); }
float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7)))*43758.5453); }
void main() {
    vec2 uv = fragTexCoord;
    float d = dist(uv);
    float de = dist(uv - edgeDir*EDGE_PX/cell);
    float aa = max(fwidth(d), 0.03)*0.8;
    float paper = 1.0 - smoothstep(PAPER_PX - aa, PAPER_PX + aa, d);
    float body = max(paper, 1.0 - smoothstep(PAPER_PX - aa, PAPER_PX + aa, de));
    float ink = 1.0 - smoothstep(INK_PX - aa, INK_PX + aa, min(d, de));
    if (ink < 0.01) discard;
    vec2 px = floor(uv*cell*4.0);
    float grain = (hash(px) - 0.5)*0.026 + (hash(floor(uv*cell*0.6)) - 0.5)*0.022;
    vec3 sheet = sheetColor + grain;
    vec3 col = mix(vec3(0.051, 0.078, 0.118), vec3(0.643, 0.596, 0.514), body);
    col = mix(col, sheet, paper);
    finalColor = vec4(col*fragColor.rgb, ink*fragColor.a);
}`

Flipbook_Assets :: struct {
	frames, papers: [Flipbook_Character]rl.Texture2D,
	// CPU copies of the fields, for picking on the paper itself.
	fields: [Flipbook_Character][]u8,
	paper_shader: rl.Shader,
	frame_a_location, frame_b_location, morph_location, cell_location, edge_location, sheet_location: c.int,
	loaded: bool,
}

// The card shader with the generator's paper constants baked in. GLSL braces
// rule out fmt templates, so named tokens are replaced instead.
flipbook_paper_source :: proc() -> cstring {
	source := string(FLIPBOOK_PAPER_FRAGMENT)
	tokens := [4]string{"PAPER_SCALE", "EDGE_PX", "PAPER_PX", "INK_PX"}
	values := [4]f32{FLIPBOOK_PAPER_SCALE, FLIPBOOK_EDGE, FLIPBOOK_PAPER, FLIPBOOK_PAPER+FLIPBOOK_INK}
	for token, index in tokens {
		source, _ = strings.replace_all(source, token, fmt.tprintf("%.4f", values[index]), context.temp_allocator)
	}
	return strings.clone_to_cstring(source, context.temp_allocator)
}

create_flipbook_assets :: proc(assets: ^Flipbook_Assets) {
	for character in Flipbook_Character {
		assets.frames[character], assets.papers[character], assets.fields[character] =
			load_paper_textures(FLIPBOOK_FRAMES_PNG[character], FLIPBOOK_PAPER_PNG[character], false)
	}
	assets.paper_shader = rl.LoadShaderFromMemory(nil, flipbook_paper_source())
	if assets.paper_shader.id != 0 {
		assets.frame_a_location = rl.GetShaderLocation(assets.paper_shader, "frameA")
		assets.frame_b_location = rl.GetShaderLocation(assets.paper_shader, "frameB")
		assets.morph_location = rl.GetShaderLocation(assets.paper_shader, "morph")
		assets.cell_location = rl.GetShaderLocation(assets.paper_shader, "cell")
		assets.edge_location = rl.GetShaderLocation(assets.paper_shader, "edgeDir")
		assets.sheet_location = rl.GetShaderLocation(assets.paper_shader, "sheetColor")
	}
	assets.loaded = assets.paper_shader.id != 0
	for character in Flipbook_Character {
		if assets.frames[character].id == 0 || assets.papers[character].id == 0 { assets.loaded = false }
	}
}

destroy_flipbook_assets :: proc(assets: ^Flipbook_Assets) {
	for character in Flipbook_Character {
		unload_paper_textures(assets.frames[character], assets.papers[character], assets.fields[character])
	}
	if assets.paper_shader.id != 0 { rl.UnloadShader(assets.paper_shader) }
	assets^ = {}
}

// A character without a dedicated clip borrows the closest one it has.
flipbook_resolve :: proc(character: Flipbook_Character, action: Flipbook_Action) -> Flipbook_Action {
	clips := &FLIPBOOK_SHEETS[character].clips
	current := action
	for _ in 0..<4 {
		if clips[current].count > 0 { return current }
		switch current {
		case .Cast: current = .Attack
		case .Dodge: current = .Walk
		case .Block: current = .Hurt
		case .Idle, .Walk, .Attack, .Windup, .Hurt, .Stunned, .Interact, .Death: current = .Idle
		}
	}
	return .Idle
}

flipbook_priority :: proc(action: Flipbook_Action) -> int {
	switch action {
	case .Death: return 6
	case .Hurt: return 5
	case .Cast, .Attack: return 4
	case .Block, .Dodge: return 3
	case .Interact: return 2
	case .Walk, .Windup, .Stunned: return 1
	case .Idle: return 0
	}
	return 0
}

flipbook_clip_seconds :: proc(clip: ^Flipbook_Clip, first: i32 = 0) -> f64 {
	return clip_duration_seconds(clip.durations[:max(clip.count, 0)], first)
}

// The drawing shown `elapsed` seconds into a clip that began at drawing
// `first`. A finished one-shot holds its last drawing.
flipbook_frame :: proc(clip: ^Flipbook_Clip, elapsed: f64, first: i32 = 0) -> (frame: i32, finished: bool) {
	if clip.count <= 0 { return 0, true }
	t := max(elapsed, 0)*1000
	if clip.loop {
		cycle := flipbook_clip_seconds(clip)*1000
		if cycle <= 0 { return 0, false }
		t = math.mod(t, cycle)
		frame, _ = clip_frame_at_ms(clip.durations[:clip.count], t)
		return frame, false
	}
	return clip_frame_at_ms(clip.durations[:clip.count], t, first)
}

// The paper's morph between two drawings: uv rects in the field atlas.
Flipbook_Paper :: struct {
	from, to: rl.Rectangle,
	morph: f32,
}

// Tracks the drawing on the card and the one it is leaving. Call once per
// drawn frame with the drawing about to be printed.
Flipbook_Page :: struct {
	shown, previous: [2]i32,
	since: f64,
	valid: bool,
}

flipbook_turn_page :: proc(page: ^Flipbook_Page, assets: ^Flipbook_Assets, character: Flipbook_Character,
	row, frame: i32, now: f64) -> Flipbook_Paper {
	shown := [2]i32{row, frame}
	if page == nil {
		rect := flipbook_paper_rect(assets, character, shown)
		return {rect, rect, 1}
	}
	if !page.valid { page^ = {shown, shown, now-FLIPBOOK_MORPH_SECONDS, true} }
	else if page.shown != shown { page.previous, page.shown, page.since = page.shown, shown, now }
	return {flipbook_paper_rect(assets, character, page.previous), flipbook_paper_rect(assets, character, page.shown),
		f32(clamp((now-page.since)/FLIPBOOK_MORPH_SECONDS, 0, 1))}
}

flipbook_paper_rect :: proc(assets: ^Flipbook_Assets, character: Flipbook_Character, drawing: [2]i32) -> rl.Rectangle {
	sheet := &FLIPBOOK_SHEETS[character]
	texture := assets.papers[character]
	w := f32(sheet.paper_cell.x)/f32(max(texture.width, 1))
	h := f32(sheet.paper_cell.y)/f32(max(texture.height, 1))
	return {f32(drawing.y)*w, f32(drawing.x)*h, w, h}
}

// Draws the paper for a print quad (corners top-left, bottom-left,
// bottom-right, top-right) grown by the sheet's paper margin in the quad's
// own axes; the paper never takes the print's hit flash.
draw_flipbook_paper :: proc(assets: ^Flipbook_Assets, character: Flipbook_Character, print: [4]Vec3,
	paper: Flipbook_Paper, mirror: bool, opacity: f32 = 1, tint: rl.Color = rl.WHITE) {
	if assets.paper_shader.id == 0 { return }
	sheet := &FLIPBOOK_SHEETS[character]
	points := paper_quad_points(print, {f32(sheet.cell.x), f32(sheet.cell.y)}, f32(sheet.card_margin))
	uv := [4]Vec2{{0, 0}, {0, 1}, {1, 1}, {1, 0}}
	if mirror { uv = {{1, 0}, {1, 1}, {0, 1}, {0, 0}} }
	begin_paper_material(assets, {
		frames = paper, cell = {f32(sheet.paper_cell.x), f32(sheet.paper_cell.y)},
		edge = {-1 if mirror else 1, 1}, sheet = FLIPBOOK_SHEET_COLOR,
	})
	draw_texture_quad(assets.papers[character].id, points, uv, {tint.r, tint.g, tint.b, u8(clamp(opacity, 0, 1)*f32(tint.a))})
	rl.EndShaderMode()
}

draw_flipbook_print :: proc(assets: ^Flipbook_Assets, character: Flipbook_Character, print: [4]Vec3,
	row, frame: i32, mirror: bool, tint: rl.Color = rl.WHITE) {
	sheet := &FLIPBOOK_SHEETS[character]
	texture := assets.frames[character]
	if texture.id == 0 { return }
	w, h := f32(sheet.cell.x), f32(sheet.cell.y)
	source := rl.Rectangle{f32(frame)*w, f32(row)*h, w, h}
	uv := [4]Vec2{{0, 0}, {0, 1}, {1, 1}, {1, 0}}
	if mirror { uv = {{1, 0}, {1, 1}, {0, 1}, {0, 0}} }
	for &coord in uv {
		coord = {(source.x+coord.x*source.width)/f32(texture.width), (source.y+coord.y*source.height)/f32(texture.height)}
	}
	draw_texture_quad(texture.id, print, uv, tint)
}

// --------------------------------------------------------------------------
// A small player for minigames: one looping state and one-shots on top.

Flipbook_Player :: struct {
	character: Flipbook_Character,
	// `action` is the running one-shot (Idle: none); `base` the loop beneath.
	action, base: Flipbook_Action,
	first: i32,
	started, base_started: f64,
	page: Flipbook_Page,
}

flipbook_player :: proc(character: Flipbook_Character, phase: f64 = 0) -> Flipbook_Player {
	return {character = character, base_started = -phase}
}

// Sets the looping state (idle, walk, windup, stunned); no restart when unchanged.
flipbook_loop :: proc(player: ^Flipbook_Player, action: Flipbook_Action, now: f64) {
	if action == player.base { return }
	player.base, player.base_started = action, now
}

// Starts a one-shot. A lower-priority action never cuts a stronger one
// before its impact drawing; `from_hit` starts on the impact itself.
flipbook_play :: proc(player: ^Flipbook_Player, action: Flipbook_Action, now: f64, from_hit := false) {
	resolved := flipbook_resolve(player.character, action)
	clip := &FLIPBOOK_SHEETS[player.character].clips[resolved]
	if clip.loop { flipbook_loop(player, resolved, now); return }
	if player.action == .Death { return }
	if flipbook_player_busy(player, now) && flipbook_priority(resolved) < flipbook_priority(player.action) {
		current := &FLIPBOOK_SHEETS[player.character].clips[player.action]
		frame, _ := flipbook_frame(current, now-player.started, player.first)
		if current.hit >= 0 && frame <= current.hit { return }
	}
	player.action, player.started = resolved, now
	player.first = max(clip.hit, 0) if from_hit else 0
}

flipbook_player_busy :: proc(player: ^Flipbook_Player, now: f64) -> bool {
	if player.action == .Idle { return false }
	if player.action == .Death { return true }
	return now-player.started < flipbook_clip_seconds(&FLIPBOOK_SHEETS[player.character].clips[player.action], player.first)
}

flipbook_player_drawing :: proc(player: ^Flipbook_Player, now: f64) -> (action: Flipbook_Action, row, frame: i32) {
	sheet := &FLIPBOOK_SHEETS[player.character]
	if player.action != .Idle {
		clip := &sheet.clips[player.action]
		drawing, finished := flipbook_frame(clip, now-player.started, player.first)
		if !finished || player.action == .Death { return player.action, clip.row, drawing }
	}
	base := flipbook_resolve(player.character, player.base)
	drawing, _ := flipbook_frame(&sheet.clips[base], now-player.base_started)
	return base, sheet.clips[base].row, drawing
}

// A camera-facing standee whose feet stand at `feet`; `height` is the
// figure's resting height in world units. Draw with depth writes on (opaque
// pass) or off (sorted alpha pass), as the scene prefers.
draw_flipbook_billboard :: proc(assets: ^Flipbook_Assets, cam: rl.Camera3D, player: ^Flipbook_Player, feet: Vec3,
	height: f32, mirror: bool = false, tint: rl.Color = rl.WHITE, now: f64 = 0, paper := true) {
	if !assets.loaded || player == nil { return }
	print, row, frame := flipbook_billboard_quad(cam, player, feet, height, mirror, now)
	if paper {
		draw_flipbook_paper(assets, player.character, print, flipbook_turn_page(&player.page, assets, player.character, row, frame, now),
			mirror, f32(tint.a)/255, {tint.r, tint.g, tint.b, 255})
	}
	draw_flipbook_print(assets, player.character, print, row, frame, mirror, tint)
}

// The print quad (top-left, bottom-left, bottom-right, top-right) of a
// camera-facing standee and the drawing to print on it, for scenes that
// draw the paper and the print in passes of their own.
flipbook_billboard_quad :: proc(cam: rl.Camera3D, player: ^Flipbook_Player, feet: Vec3, height: f32, mirror: bool,
	now: f64) -> (print: [4]Vec3, row, frame: i32) {
	character := player.character
	sheet := &FLIPBOOK_SHEETS[character]
	_, row, frame = flipbook_player_drawing(player, now)
	scale := height/max(sheet.rest_height, 1)
	view := Vec3{cam.position.x-cam.target.x, 0, cam.position.z-cam.target.z}
	right := Vec3{view.z, 0, -view.x}
	length := math.sqrt(right.x*right.x+right.z*right.z)
	right = Vec3{1, 0, 0} if length < 0.0001 else right/length
	up := Vec3{0, 1, 0}
	feet_x := f32(sheet.cell.x)-sheet.feet.x if mirror else sheet.feet.x
	below := f32(sheet.cell.y)-sheet.feet.y
	bl := feet-right*(feet_x*scale)-up*(below*scale)
	span := right*(f32(sheet.cell.x)*scale)
	top := up*(f32(sheet.cell.y)*scale)
	print = {bl+top, bl, bl+span, bl+span+top}
	return
}

// The same standee on a 2D screen: `feet` in screen pixels, `pixel` screen
// pixels per drawing pixel. Paper and print share the destination quad.
draw_flipbook_2d :: proc(assets: ^Flipbook_Assets, player: ^Flipbook_Player, feet: Vec2, pixel: f32,
	mirror: bool = false, tint: rl.Color = rl.WHITE, now: f64 = 0) {
	if !assets.loaded || player == nil { return }
	character := player.character
	sheet := &FLIPBOOK_SHEETS[character]
	_, row, frame := flipbook_player_drawing(player, now)
	feet_x := f32(sheet.cell.x)-sheet.feet.x if mirror else sheet.feet.x
	x0 := feet.x-feet_x*pixel
	y0 := feet.y-sheet.feet.y*pixel
	x1 := x0+f32(sheet.cell.x)*pixel
	y1 := y0+f32(sheet.cell.y)*pixel
	print := [4]Vec3{{x0, y0, 0}, {x0, y1, 0}, {x1, y1, 0}, {x1, y0, 0}}
	rlgl.DrawRenderBatchActive()
	rlgl.DisableBackfaceCulling()
	defer { rlgl.DrawRenderBatchActive(); rlgl.EnableBackfaceCulling() }
	draw_flipbook_paper(assets, character, print, flipbook_turn_page(&player.page, assets, character, row, frame, now), mirror, f32(tint.a)/255)
	draw_flipbook_print(assets, character, print, row, frame, mirror, tint)
}
