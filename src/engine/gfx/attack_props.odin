package gfx

import "core:c"
import rl "vendor:raylib"

// The paper props of the board's blows (attack_props_data.odin, generated by
// tools/art/build_attack_props.py): the prints, pixel art never filtered, and
// their paper fields, cut by the cards' own shader (flipbook.odin).
Attack_Props :: struct {
	print, paper: rl.Texture2D,
	loaded, failed: bool,
}

create_attack_props :: proc(props: ^Attack_Props) {
	for bytes, kind in ([2][]u8{ATTACK_PROPS_PNG, ATTACK_PROPS_PAPER_PNG}) {
		img := rl.LoadImageFromMemory(".png", raw_data(bytes), c.int(len(bytes)))
		if img.data == nil { continue }
		texture := rl.LoadTextureFromImage(img)
		rl.UnloadImage(img)
		if kind == 0 {
			rl.SetTextureFilter(texture, .POINT)
			props.print = texture
		} else {
			// Distance fields interpolate: bilinear, clamped (the cells abut).
			rl.SetTextureFilter(texture, .BILINEAR)
			rl.SetTextureWrap(texture, .CLAMP)
			props.paper = texture
		}
	}
	props.loaded = props.print.id != 0 && props.paper.id != 0
	props.failed = !props.loaded
}

destroy_attack_props :: proc(props: ^Attack_Props) {
	if props.print.id != 0 { rl.UnloadTexture(props.print) }
	if props.paper.id != 0 { rl.UnloadTexture(props.paper) }
	props^ = {}
}
