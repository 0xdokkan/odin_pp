package audio

import "core:c"
import rl "vendor:raylib"

// The mechanics lab's sound effects (lab_sfx_data.odin, generated by
// tools/audio/build_sfx.py from code: no recordings), carried as Ogg Vorbis.
// Decoded the first time the lab needs them and only if the audio device is
// open; every call is a no-op otherwise, so the game never branches on it.

// Voices per effect: overlapping plays rotate through aliases.
LAB_VOICES :: 3
// The bus limiter's ceiling (-1 dBFS) and its release toward unity per
// frame (about 45 ms at 44.1 kHz).
LAB_LIMIT :: f32(0.89)
LAB_LIMIT_RELEASE :: f32(0.9995)

Lab_Bank :: struct {
	ready, failed: bool,
	sounds: [Lab_Sfx][LAB_VOICES]rl.Sound,
	next: [Lab_Sfx]int,
	ambience: rl.Music,
	ambience_sfx: Lab_Sfx,
	ambience_on: bool,
	// The first person music (lab_music): the track playing, how far it is faded in.
	music: rl.Music,
	music_on: bool,
	music_track: Lab_Music,
	music_level: f32,
}

// The first person cards' music, stereo loops made from code and encoded by
// tools/audio/encode_music.py: the fists' (32 s, tools/audio/music_brawler.py),
// the sword's (40 s, tools/audio/music_fencer.py) and the bow's (37 s,
// tools/audio/music_archer.py).
Lab_Music :: enum u8 {None, Brawler, Fencer, Archer}
LAB_MUSIC_DATA := [Lab_Music][]u8{
	.None = nil,
	.Brawler = #load("../../../assets/audio/music/brawler.ogg"),
	.Fencer = #load("../../../assets/audio/music/fencer.ogg"),
	.Archer = #load("../../../assets/audio/music/archer.ogg"),
}
// Seconds to fade it in or out; its level against the effects.
LAB_MUSIC_FADE :: f32(0.5)
LAB_MUSIC_LEVEL :: f32(0.75)

lab_bank_load :: proc(b: ^Lab_Bank) -> bool {
	if b.ready { return true }
	if b.failed || !rl.IsAudioDeviceReady() { return false }
	for sfx in Lab_Sfx {
		bytes := LAB_SFX_OGG[sfx]
		if LAB_SFX_LOOP[sfx] { continue }
		wave := rl.LoadWaveFromMemory(".ogg", raw_data(bytes), c.int(len(bytes)))
		if wave.data == nil { b.failed = true; continue }
		base := rl.LoadSoundFromWave(wave)
		rl.UnloadWave(wave)
		b.sounds[sfx][0] = base
		for v in 1..<LAB_VOICES { b.sounds[sfx][v] = rl.LoadSoundAlias(base) }
	}
	b.ready = true
	rl.AttachAudioMixedProcessor(lab_limiter)
	return true
}

// Each sound peaks under the ceiling, but a blow, a fall and a blast at
// once add up: the mixed output (stereo floats, before the master volume)
// is held under it. Instant attack, so nothing gets through; a smooth
// release, so nothing pumps. The gain lives on the audio thread only.
@(private)
lab_limiter_gain: f32 = 1

lab_limiter :: proc "c" (buffer: rawptr, frames: c.uint) {
	samples := ([^]f32)(buffer)
	gain := lab_limiter_gain
	for frame in 0..<int(frames) {
		left, right := samples[2*frame], samples[2*frame+1]
		peak := max(abs(left), abs(right))
		gain = 1-(1-gain)*LAB_LIMIT_RELEASE
		if peak*gain > LAB_LIMIT { gain = LAB_LIMIT/peak }
		samples[2*frame], samples[2*frame+1] = left*gain, right*gain
	}
	lab_limiter_gain = gain
}

lab_bank_unload :: proc(b: ^Lab_Bank) {
	if b == nil { return }
	if b.ready && rl.IsAudioDeviceReady() {
		rl.DetachAudioMixedProcessor(lab_limiter)
		lab_ambience(b, false)
		lab_music_stop(b)
		for sfx in Lab_Sfx {
			if LAB_SFX_LOOP[sfx] || b.sounds[sfx][0].frameCount == 0 { continue }
			for v in 1..<LAB_VOICES { rl.UnloadSoundAlias(b.sounds[sfx][v]) }
			rl.UnloadSound(b.sounds[sfx][0])
		}
	}
	b^ = {}
}

// volume 0..1 (already scaled by the player's settings), pitch 1 = as made,
// pan -1 left .. 1 right.
lab_play :: proc(b: ^Lab_Bank, sfx: Lab_Sfx, volume: f32 = 1, pitch: f32 = 1, pan: f32 = 0) {
	if b == nil || !b.ready || LAB_SFX_LOOP[sfx] || volume <= 0 { return }
	voice := b.next[sfx]
	b.next[sfx] = (voice+1)%LAB_VOICES
	s := b.sounds[sfx][voice]
	if s.frameCount == 0 { return }
	rl.SetSoundVolume(s, clamp(volume, 0, 1))
	rl.SetSoundPitch(s, clamp(pitch, 0.5, 2))
	rl.SetSoundPan(s, clamp(pan, -1, 1))
	rl.PlaySound(s)
}

// The track `wanted` this frame (None: silence): it fades in over
// LAB_MUSIC_FADE seconds from the top of its loop, and out, then stops; a
// different track waits for the one playing to fade out. `volume` is the
// player's effects volume.
lab_music :: proc(b: ^Lab_Bank, wanted: Lab_Music, volume, dt: f32) {
	if b == nil || !b.ready { return }
	step := max(dt, 0)/LAB_MUSIC_FADE
	on := wanted != .None && (!b.music_on || b.music_track == wanted)
	b.music_level = min(f32(1), b.music_level+step) if on else max(f32(0), b.music_level-step)
	if b.music_level <= 0 {
		lab_music_stop(b)
		return
	}
	if !b.music_on {
		data := LAB_MUSIC_DATA[wanted]
		b.music = rl.LoadMusicStreamFromMemory(".ogg", raw_data(data), c.int(len(data)))
		if !rl.IsMusicValid(b.music) { b.music_level = 0; return }
		b.music.looping = true
		b.music_on, b.music_track = true, wanted
		rl.PlayMusicStream(b.music)
	}
	rl.SetMusicVolume(b.music, clamp(volume*LAB_MUSIC_LEVEL*b.music_level, 0, 1))
	rl.UpdateMusicStream(b.music)
}

lab_music_stop :: proc(b: ^Lab_Bank) {
	if b == nil || !b.music_on { return }
	if rl.IsAudioDeviceReady() {
		rl.StopMusicStream(b.music)
		rl.UnloadMusicStream(b.music)
	}
	b.music, b.music_on, b.music_track, b.music_level = {}, false, .None, 0
}

// The room's ambience loop, streamed from the embedded file.
lab_ambience :: proc(b: ^Lab_Bank, on: bool, sfx: Lab_Sfx = {}, volume: f32 = 1) {
	if b == nil || !b.ready { return }
	if !on {
		if b.ambience_on {
			rl.StopMusicStream(b.ambience)
			rl.UnloadMusicStream(b.ambience)
			b.ambience_on = false
		}
		return
	}
	if !b.ambience_on {
		bytes := LAB_SFX_OGG[sfx]
		b.ambience = rl.LoadMusicStreamFromMemory(".ogg", raw_data(bytes), c.int(len(bytes)))
		if !rl.IsMusicValid(b.ambience) { return }
		b.ambience.looping = true
		b.ambience_sfx, b.ambience_on = sfx, true
		rl.PlayMusicStream(b.ambience)
	}
	rl.SetMusicVolume(b.ambience, clamp(volume, 0, 1))
	rl.UpdateMusicStream(b.ambience)
}
