	.World_Tesla_Deploy = #load("../../../assets/audio/lab/world_tesla_deploy.ogg"),
	.World_Tesla_Ring = #load("../../../assets/audio/lab/world_tesla_ring.ogg"),
	.World_Tesla_Zap = #load("../../../assets/audio/lab/world_tesla_zap.ogg"),
}

